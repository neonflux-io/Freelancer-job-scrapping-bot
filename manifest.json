{
  "manifest_version": 3,
  "name": "Freelancer Unified Notifier",
  "version": "2.0.0",
  "description": "Monitors Freelancer jobs and unread messages, then sends Telegram notifications.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.freelancer.com/*",
    "https://api.telegram.org/*",
    "https://llama.orsentra.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.freelancer.com/*"
      ],
      "js": [
        "shared/common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
